<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- 网络权限必须显式声明：实测 retrofit / okhttp 的 AAR-free jar 都不会合并出 INTERNET
         （票 #48 Q5：只声明依赖时合并清单里没有该权限，手写后 APK 才有）。 -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- Android 11+（targetSdk 30 起）的包可见性限制：不声明 <queries> 时
         PackageManager.getLaunchIntentForPackage("com.tencent.mm") 直接返回 null，
         表现为「点跳转微信没任何反应」（且不会抛异常，极难排查）。
         这里显式声明微信包与 weixin scheme，两者都需要。 -->
    <queries>
        <package android:name="com.tencent.mm" />
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="weixin" />
        </intent>
    </queries>

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.NongyuAppPlus">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/Theme.NongyuAppPlus"
            android:windowSoftInputMode="adjustNothing">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>

</manifest>
